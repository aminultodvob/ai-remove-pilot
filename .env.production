# Public base URL of the deployment. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_APP_URL=https://airemove.replyot.com

# Largest image the API will accept, in megabytes. Also surfaced in the UI.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=4
MAX_UPLOAD_SIZE_MB=

# Hard ceiling on how long a single image may occupy a worker, in milliseconds.
PROCESSING_TIMEOUT_MS=30000

# How long an in-flight job may live before the sweeper force-releases its buffers.
# Nothing is written to disk, so this bounds in-memory residency, not file lifetime.
TEMP_FILE_TTL_SECONDS=300

# Fixed-window rate limit applied per client IP to /api/process.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Largest pixel count (width * height) that will be decoded, in megapixels.
# Guards against decompression bombs.
MAX_IMAGE_MEGAPIXELS=100

# Event-only analytics. Never receives image data. Off unless explicitly enabled.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
